{
	"compilerOptions": {
		"target": "ES2021",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"paths": {
			"@/*": ["./src/*"],
			"@modules/*": ["./src/modules/*"],
			"@infra/*": ["./src/infrastructure/*"],
			"@shared/*": ["./src/shared/*"]
		},
		"types": [
			"bun-types"
		],
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
